---
import Base from '../layouts/Base.astro';
import Donate from '../components/Donate.astro';
import { donateMeta } from '../data/pageMeta.js';
const locale = 'en';
const m = donateMeta(locale);
---
<Base title={m.title} description={m.description} keywords={m.keywords} path={m.path} locale={locale} jsonLd={m.jsonLd}>
  <Donate locale={locale} />
</Base>
