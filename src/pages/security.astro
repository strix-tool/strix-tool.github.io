---
import Base from '../layouts/Base.astro';
import Security from '../components/Security.astro';
import { securityMeta } from '../data/pageMeta.js';
const locale = 'en';
const m = securityMeta(locale);
---
<Base title={m.title} description={m.description} keywords={m.keywords} path={m.path} locale={locale} jsonLd={m.jsonLd}>
  <Security locale={locale} />
</Base>
