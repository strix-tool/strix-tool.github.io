---
import Base from '../layouts/Base.astro';
import DownloadsPage from '../components/DownloadsPage.astro';
import { downloadsMeta } from '../data/pageMeta.js';
const locale = 'en';
const m = downloadsMeta(locale);
---
<Base title={m.title} description={m.description} keywords={m.keywords} path={m.path} locale={locale} jsonLd={m.jsonLd}>
  <DownloadsPage locale={locale} />
</Base>
