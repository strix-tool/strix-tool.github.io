---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { homeMeta } from '../data/pageMeta.js';
const locale = 'en';
const m = homeMeta(locale);
---
<Base title={m.title} description={m.description} keywords={m.keywords} path={m.path} locale={locale} jsonLd={m.jsonLd}>
  <Home locale={locale} />
</Base>
