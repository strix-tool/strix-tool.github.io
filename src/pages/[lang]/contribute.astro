---
import Base from '../../layouts/Base.astro';
import Contribute from '../../components/Contribute.astro';
import { contributeMeta } from '../../data/pageMeta.js';
import { NON_DEFAULT_LOCALES } from '../../data/i18n.js';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang;
const m = contributeMeta(locale);
---
<Base title={m.title} description={m.description} keywords={m.keywords} path={m.path} locale={locale} jsonLd={m.jsonLd}>
  <Contribute locale={locale} />
</Base>
