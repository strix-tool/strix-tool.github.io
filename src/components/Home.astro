---
import fs from 'node:fs';
import { t, appPath, downloadsPath } from '../data/site.js';
import { getUI, localizeApp, categoryLabel, localizePath } from '../data/i18n.js';
import { apps } from '../data/apps.js';
import { mockup } from '../data/mockups.js';
import AppIcon from './AppIcon.astro';
const { locale = 'en' } = Astro.props;
const tt = getUI(locale);
const stats = [[String(apps.length), tt.stats.tools], ['2', tt.stats.platforms], ['0', tt.stats.telemetry], ['MIT', tt.stats.license]];
const shotOf = (slug) => (fs.existsSync(`public/screens/${slug}.png`) ? `/screens/${slug}.png` : null);
const cats = [...new Set(apps.map((a) => a.category))];
const lapps = apps.map((a) => localizeApp(a, locale));
const whyIcons = {
  offline: '<path d="M18.5 15A3.5 3.5 0 0 0 17 8.2 5.5 5.5 0 0 0 6.5 9" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/><path d="M6 15h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M3.5 3.5l17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  hardened: '<path d="M12 3l8 3v6c0 5-3.6 8-8 9-4.4-1-8-4-8-9V6z" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linejoin="round"/><path d="M8.5 12l2.3 2.3L15.5 9.6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>',
  cross: '<rect x="2.5" y="4.5" width="13" height="9.5" rx="1.4" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="M6.5 18h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><rect x="16.5" y="8.5" width="5" height="10" rx="1.2" stroke="currentColor" stroke-width="1.8" fill="none"/>',
  open: '<path d="M8.5 8.5l-4 3.5 4 3.5M15.5 8.5l4 3.5-4 3.5M13.5 6l-3 12" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>',
};
---
<section class="hero">
  <div class="wrap">
    <span class="chip">🛡 {tt.heroBadge}</span>
    <h1>{tt.heroTitle}</h1>
    <p class="sub">{tt.heroSubtitle}</p>
    <div class="cta">
      <a class="btn primary" href="#tools">{tt.browse}</a>
      <a class="btn" href={localizePath(downloadsPath(), locale)}>↓ {tt.getStarted}</a>
    </div>
    <div class="stats">
      {stats.map(([n, l]) => (<div><b>{n}</b><span>{l}</span></div>))}
    </div>
  </div>
</section>

<section class="section" id="tools">
  <div class="wrap">
    <div class="sechead">
      <h2>{tt.allApps}</h2>
      <p class="lead">{tt.allAppsLead}</p>
    </div>

    <div class="finder" id="finder">
      <label class="finder-search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="toolSearch" type="search" placeholder={tt.toolsSearchPlaceholder} autocomplete="off" spellcheck="false" aria-label="Search tools" />
        <kbd class="khint">/</kbd>
      </label>
      <div class="finder-chips" role="group" aria-label="Filter by category">
        <button type="button" class="fchip is-on" data-filter="cat" data-val="">{tt.toolsFilterAll}</button>
        {cats.map((c) => <button type="button" class="fchip" data-filter="cat" data-val={c}>{categoryLabel(c, locale)}</button>)}
      </div>
    </div>
    <p class="no-match" id="noMatch" hidden>{tt.toolsNoMatch}</p>

    <div class="appgrid" id="appgrid">
      {lapps.map((a) => (
        <a class="appcard reveal" href={localizePath(appPath(a.slug), locale)} style={`--ac:${a.accent}`}
           data-name={a.name.toLowerCase()} data-cat={a.category}
           data-plats={a.platforms.join(',')} data-kw={(a.keywords || '').toLowerCase()}>
          <div class="cardshot">
            {shotOf(a.slug)
              ? <img src={shotOf(a.slug)} alt={`${a.name} — ${a.tagline}`} loading="lazy" decoding="async" />
              : <div class="cardshot-mock" set:html={mockup(a.slug, a.accent)} />}
          </div>
          <div class="cardtop">
            <AppIcon id={a.iconId} accent={a.accent} accent2={a.accent2} size={44} />
            {a.danger && <span class="warnflag" title="Destructive tool">⚠</span>}
          </div>
          <h3>{a.name}</h3>
          <div class="cat">{categoryLabel(a.category, locale)} · {a.tech}</div>
          <p>{a.tagline}</p>
          <div class="foot">
            <div class="plats">{a.platforms.map((p) => <span class="pill">{p}</span>)}</div>
            <span class="more">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section why-sec">
  <div class="wrap">
    <div class="sechead">
      <h2>{tt.whyTitle}</h2>
      {tt.whyLead && <p class="lead">{tt.whyLead}</p>}
    </div>
    <div class="why">
      {tt.why.map((w, i) => (
        <div class="box reveal">
          <div class="why-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" set:html={whyIcons[w.k] || ''} />
          </div>
          <span class="num">0{i + 1}</span>
          <h3>{w.title}</h3>
          <p>{w.text}</p>
          <div class="why-proof"><span class="tick">✓</span>{w.proof}</div>
        </div>
      ))}
    </div>
    <p class="secnote">{tt.securityNote}</p>
  </div>
</section>

<section class="section" id="faq">
  <div class="wrap">
    <div class="sechead"><h2>{tt.faqTitle}</h2></div>
    <label class="faq-search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <input id="faqSearch" type="search" placeholder={tt.faqSearchPlaceholder} aria-label="Search the FAQ" autocomplete="off" spellcheck="false" />
    </label>
    <div class="homefaq" id="homefaq">
      {tt.homeFaq.map(([q, a]) => (
        <details class="hfaq" data-q={(q + ' ' + a).toLowerCase()}>
          <summary>{q}</summary><p>{a}</p></details>
      ))}
    </div>
    <p class="no-match" id="faqNoMatch" hidden>{tt.faqNoMatch}</p>
  </div>
</section>

<style>
  .homefaq{max-width:760px;margin:0 auto}
  .homefaq .hfaq{border-top:1px solid var(--edge);padding:16px 4px}
  .homefaq .hfaq:first-of-type{border-top:none}
  .homefaq summary{cursor:pointer;font-weight:600;font-size:16px;list-style:none}
  .homefaq summary::-webkit-details-marker{display:none}
  .homefaq summary::before{content:"+ ";color:var(--accent);font-weight:800}
  .homefaq .hfaq[open] summary::before{content:"– "}
  .homefaq .hfaq p{color:var(--dim);font-size:14.5px;margin:10px 0 0}
  .hero{padding:88px 0 30px;text-align:center}
  .hero .chip{margin-bottom:22px}
  .hero h1{font-size:clamp(34px,5.4vw,60px);margin:0 auto 20px;max-width:16ch;font-weight:800}
  .hero .sub{color:var(--dim);font-size:clamp(16px,2.1vw,20px);max-width:62ch;margin:0 auto 30px}
  .hero .cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .stats{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:44px}
  .stats>div{background:var(--card);border:1px solid var(--edge);border-radius:14px;padding:14px 22px;min-width:92px}
  .stats b{display:block;font-size:26px;font-weight:800;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  .stats span{color:var(--faint);font-size:13px}
  .section{padding:56px 0}
  .sechead{text-align:center;margin-bottom:34px}
  .sechead h2{font-size:clamp(26px,3.4vw,36px);margin:0 0 8px}
  .sechead .lead{color:var(--dim);margin:0;font-size:17px}
  .appgrid{display:flex;flex-wrap:wrap;gap:20px;justify-content:center}
  .appcard{flex:0 1 336px;display:flex;flex-direction:column;background:var(--card);overflow:hidden;
    border:1px solid var(--edge);border-radius:var(--r-lg);padding:24px;transition:transform .18s,border-color .18s,box-shadow .18s}
  .appcard:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--ac) 65%,var(--edge));box-shadow:var(--sh)}
  .cardshot{height:168px;margin:-24px -24px 18px;overflow:hidden;background:#0b0f1c;
    border-bottom:1px solid var(--edge);position:relative}
  .cardshot::after{content:"";position:absolute;inset:auto 0 0 0;height:52px;
    background:linear-gradient(to top,var(--card),transparent);pointer-events:none}
  .cardshot img{width:100%;height:100%;object-fit:cover;object-position:top center;
    display:block;transition:transform .4s ease}
  .appcard:hover .cardshot img{transform:scale(1.035)}
  .cardshot-mock{width:100%}
  .cardshot-mock :global(svg){width:100%;height:auto;display:block}
  .cardtop{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px;margin-top:-6px}
  .warnflag{color:#ff6b7d;font-size:18px}
  .appcard h3{margin:0;font-size:20px}
  .appcard .cat{color:var(--faint);font-size:13px;margin-top:3px}
  .appcard p{color:var(--dim);font-size:14.5px;margin:12px 0 18px;flex:1}
  .appcard .foot{display:flex;align-items:center;justify-content:space-between;gap:10px}
  .appcard .plats{display:flex;gap:6px;flex-wrap:wrap}
  .appcard .more{color:var(--ac);font-weight:800;font-size:18px;transition:transform .18s}
  .appcard:hover .more{transform:translateX(4px)}
  .why-sec{background:var(--bg-1);border-block:1px solid var(--edge)}
  .why{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
  .why .box{background:var(--card);border:1px solid var(--edge);border-radius:var(--r);padding:22px;position:relative}
  .why .num{font-size:12px;font-weight:800;color:var(--faint);letter-spacing:.1em}
  .why .box h3{margin:8px 0 6px;font-size:16px}
  .why .box p{margin:0;color:var(--dim);font-size:14px}
  .secnote{text-align:center;color:var(--faint);font-size:14px;max-width:70ch;margin:30px auto 0}

  /* ---- interaktiver Tool-Finder ---- */
  .finder{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:center;
    max-width:920px;margin:0 auto 30px}
  .finder-search{display:flex;align-items:center;gap:9px;flex:1 1 320px;min-width:260px;
    background:var(--card);border:1px solid var(--edge);border-radius:13px;padding:0 12px;color:var(--faint);
    transition:border-color .15s,box-shadow .15s}
  .finder-search:focus-within{border-color:color-mix(in srgb,var(--accent) 60%,var(--edge));box-shadow:0 0 0 4px var(--ring)}
  .finder-search input{flex:1;background:none;border:none;outline:none;color:var(--text);
    font-size:15px;padding:12px 0;font-family:inherit}
  .khint{font-size:11px;color:var(--faint);border:1px solid var(--edge);border-radius:6px;
    padding:2px 7px;background:var(--bg-2);font-family:ui-monospace,monospace}
  .finder-chips{display:flex;gap:7px;flex-wrap:wrap;justify-content:center}
  .fchip{cursor:pointer;font:600 13px/1 inherit;padding:8px 13px;border-radius:999px;
    background:var(--card);border:1px solid var(--edge);color:var(--dim);transition:all .15s}
  .fchip:hover{color:var(--text);border-color:color-mix(in srgb,var(--accent) 45%,var(--edge))}
  .fchip.is-on{background:var(--grad);color:#fff;border-color:transparent;box-shadow:0 6px 16px -8px var(--ring)}
  .fchip.plat.is-on{background:var(--accent-2);color:#04211c}
  .no-match{text-align:center;color:var(--faint);font-size:15px;padding:30px 0}
  .appcard.hide{display:none}

  /* ---- Einblenden beim Scrollen (nur wenn JS aktiv ist, damit no-JS die Inhalte sichtbar hält) ---- */
  .reveal{transition:opacity .55s cubic-bezier(.2,.7,.2,1),transform .55s cubic-bezier(.2,.7,.2,1)}
  :global(html.js) .reveal{opacity:0;transform:translateY(16px)}
  :global(html.js) .reveal.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){:global(html.js) .reveal{opacity:1;transform:none;transition:none}}

  /* ---- angereicherte Versprechen ---- */
  .why .box{padding:24px 22px}
  .why-ico{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;color:var(--accent-2);
    background:color-mix(in srgb,var(--accent-2) 12%,transparent);border:1px solid color-mix(in srgb,var(--accent-2) 26%,transparent);margin-bottom:14px}
  .why .num{position:absolute;top:20px;right:22px}
  .why-proof{margin-top:14px;padding-top:13px;border-top:1px dashed var(--edge);
    color:var(--faint);font-size:12.5px;display:flex;gap:7px;align-items:flex-start;line-height:1.4}
  .why-proof .tick{color:var(--accent-2);font-weight:800;flex:none}

  /* ---- FAQ-Suche + weicheres Akkordeon ---- */
  .faq-search{display:flex;align-items:center;gap:9px;max-width:520px;margin:0 auto 26px;color:var(--faint);
    background:var(--card);border:1px solid var(--edge);border-radius:13px;padding:0 12px;transition:border-color .15s,box-shadow .15s}
  .faq-search:focus-within{border-color:color-mix(in srgb,var(--accent) 60%,var(--edge));box-shadow:0 0 0 4px var(--ring)}
  .faq-search input{flex:1;background:none;border:none;outline:none;color:var(--text);font-size:15px;padding:11px 0;font-family:inherit}
  .homefaq .hfaq.hide{display:none}
  .homefaq .hfaq p{color:var(--dim);font-size:14.5px;margin:10px 0 2px;line-height:1.6}
</style>

<script>
  // ---- interaktiver Tool-Finder ----
  const grid = document.getElementById('appgrid');
  if (grid) {
    const cards = Array.from(grid.querySelectorAll('.appcard'));
    const search = document.getElementById('toolSearch');
    const noMatch = document.getElementById('noMatch');
    const state = { q: '', cat: '', plat: '' };
    const apply = () => {
      let shown = 0;
      cards.forEach((c) => {
        const okCat = !state.cat || c.dataset.cat === state.cat;
        const okPlat = !state.plat || (c.dataset.plats || '').split(',').includes(state.plat);
        const hay = c.dataset.name + ' ' + c.dataset.cat + ' ' + (c.dataset.kw || '');
        const okQ = !state.q || hay.indexOf(state.q) !== -1;
        const show = okCat && okPlat && okQ;
        c.classList.toggle('hide', !show);
        if (show) shown++;
      });
      if (noMatch) noMatch.hidden = shown !== 0;
    };
    if (search) search.addEventListener('input', () => { state.q = search.value.trim().toLowerCase(); apply(); });
    document.querySelectorAll('.fchip').forEach((chip) => {
      chip.addEventListener('click', () => {
        if (chip.dataset.filter === 'cat') {
          state.cat = chip.dataset.val;
          document.querySelectorAll('.fchip[data-filter="cat"]').forEach((x) => x.classList.toggle('is-on', x === chip));
        } else {
          state.plat = state.plat === chip.dataset.val ? '' : chip.dataset.val;
          document.querySelectorAll('.fchip.plat').forEach((x) => x.classList.toggle('is-on', x.dataset.val === state.plat));
        }
        apply();
      });
    });
    document.addEventListener('keydown', (e) => {
      const a = document.activeElement;
      if (e.key === '/' && search && a !== search && !/^(input|textarea)$/i.test(a && a.tagName)) {
        e.preventDefault(); search.focus();
      }
    });
    // ?q= Deep-Link (SearchAction für Suchmaschinen + teilbare gefilterte Ansicht)
    try {
      const qp = new URLSearchParams(location.search).get('q');
      if (qp && search) {
        search.value = qp; state.q = qp.trim().toLowerCase(); apply();
        const sec = document.getElementById('tools');
        if (sec) sec.scrollIntoView({ behavior: 'smooth' });
      }
    } catch (e) {}
  }

  // ---- FAQ-Suche ----
  const faq = document.getElementById('homefaq');
  if (faq) {
    const items = Array.from(faq.querySelectorAll('.hfaq'));
    const fs = document.getElementById('faqSearch');
    const fnm = document.getElementById('faqNoMatch');
    if (fs) fs.addEventListener('input', () => {
      const q = fs.value.trim().toLowerCase();
      let shown = 0;
      items.forEach((it) => {
        const show = !q || (it.dataset.q || '').indexOf(q) !== -1;
        it.classList.toggle('hide', !show);
        it.open = !!q && show;
        if (show) shown++;
      });
      if (fnm) fnm.hidden = shown !== 0;
    });
  }

  // ---- animierte Statistik-Zähler ----
  const statObs = new IntersectionObserver((entries) => {
    entries.forEach((en) => {
      if (!en.isIntersecting) return;
      const el = en.target; statObs.unobserve(el);
      const raw = el.textContent.trim();
      const num = parseInt(raw, 10);
      // Den korrekten, serverseitig gerenderten Wert für 0 / 'MIT' unberührt lassen und wenn
      // der Nutzer reduzierte Bewegung bevorzugt — niemals zu einem falschen Endwert animieren.
      if (isNaN(num) || num === 0 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const dur = 850, t0 = performance.now();
      const tick = (now) => {
        const p = Math.min(1, (now - t0) / dur);
        el.textContent = String(Math.round(num * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick); else el.textContent = raw;
      };
      requestAnimationFrame(tick);
    });
  }, { threshold: 0.6 });
  document.querySelectorAll('.stats b').forEach((s) => statObs.observe(s));

  // ---- Einblenden beim Scrollen ----
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); revealObs.unobserve(en.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach((el) => revealObs.observe(el));

  // Ausfallsicherung: alles einblenden, was der Observer nie auslöst (gefilterte/per Deep-Link
  // aufgerufene Ansichten, Druck oder ein fehlerhafter IntersectionObserver), sodass Inhalte nie verborgen bleiben.
  const revealAll = () => document.querySelectorAll('.reveal:not(.in)').forEach((el) => el.classList.add('in'));
  setTimeout(revealAll, 1400);
  window.addEventListener('hashchange', revealAll);
</script>
