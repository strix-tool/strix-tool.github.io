---
// Seite „Über uns". Alle Texte stammen aus dem sprachspezifischen Wörterbuch
// `about` (data/i18n/*.js). Bewusst schlicht: unabhängiges, quelloffenes Team.
import { SITE } from '../data/site.js';
import { getAbout, localizePath } from '../data/i18n.js';
import { contributePath } from '../data/site.js';
import { APP_UPDATED } from '../data/apps.js';

const { locale = 'en' } = Astro.props;
const a = getAbout(locale);
---
<section class="wrap ahead">
  <span class="badge">{a.badge}</span>
  <h1>{a.h1}</h1>
  <p class="lead">{a.lead}</p>
  <p class="upd">{a.updatedLabel} <time datetime={APP_UPDATED}>{APP_UPDATED}</time></p>
</section>

<section class="wrap ablock" aria-labelledby="values">
  <h2 id="values">{a.values.h2}</h2>
  <div class="grid2">
    {a.values.list.map((it) => (
      <div class="card"><h3>{it.t}</h3><p>{it.d}</p></div>
    ))}
  </div>
</section>

<section class="wrap ablock story" aria-labelledby="story">
  <h2 id="story">{a.story.h2}</h2>
  <p>{a.story.p1}</p>
  <p>{a.story.p2}</p>
</section>

<section class="wrap ablock cta" aria-labelledby="acta">
  <h2 id="acta">{a.cta.h2}</h2>
  <p>{a.cta.p}</p>
  <div class="abtns">
    <a class="btn" href={SITE.githubUrl} rel="noopener">{a.cta.btnGithub}</a>
    <a class="btn ghost" href={localizePath(contributePath(), locale)}>{a.cta.btnContribute}</a>
  </div>
</section>

<style>
  .ahead{padding:60px 22px 6px;text-align:center;max-width:820px}
  .badge{display:inline-block;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
    color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,transparent);
    border:1px solid color-mix(in srgb,var(--accent) 35%,var(--edge));border-radius:999px;padding:5px 13px;margin-bottom:16px}
  .ahead h1{font-size:clamp(30px,4.6vw,46px);margin:0 0 14px;text-wrap:balance}
  .ahead .lead{color:var(--dim);font-size:17px;line-height:1.75;margin:0 auto}
  .ahead .upd{margin-top:16px;color:var(--faint);font-size:13px}
  .ablock{padding:38px 22px 6px;max-width:920px}
  .ablock h2{font-size:clamp(22px,3vw,28px);margin:0 0 18px}
  .grid2{display:grid;gap:14px;grid-template-columns:repeat(2,1fr)}
  .card{background:var(--card);border:1px solid var(--edge);border-radius:16px;padding:20px 22px}
  .card h3{margin:0 0 7px;font-size:16px}
  .card p{color:var(--dim);font-size:14px;line-height:1.6;margin:0}
  .story{max-width:760px}
  .story p{color:var(--dim);font-size:16px;line-height:1.8;margin:0 0 16px}
  .cta{background:var(--card);border:1px solid var(--edge);border-radius:18px;margin-top:24px;padding:28px 26px;max-width:920px}
  .cta h2{margin-top:0;margin-bottom:8px}
  .cta>p{color:var(--dim);font-size:15px;line-height:1.7;max-width:72ch;margin:0}
  .abtns{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
  .btn{display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:14.5px;
    background:var(--accent);color:#04121f;border:1px solid var(--accent);border-radius:11px;
    padding:11px 20px;transition:transform .15s,box-shadow .15s}
  .btn:hover{transform:translateY(-1px);box-shadow:0 6px 22px color-mix(in srgb,var(--accent) 35%,transparent)}
  .btn.ghost{background:transparent;color:var(--text);border-color:var(--edge-2)}
  .btn.ghost:hover{border-color:var(--accent);box-shadow:none}
  @media(max-width:640px){.grid2{grid-template-columns:1fr}}
</style>
