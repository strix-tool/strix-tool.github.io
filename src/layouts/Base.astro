---
import { SITE, t, homePath, appPath, downloadsPath, securityPath, contributePath, donatePath, aboutPath, alternativesPath } from '../data/site.js';
import { getUI, LOCALES, DEFAULT_LOCALE, localizePath, localeNames, localeShort, localeOg, localeHreflang, categoryLabel, localizeApp } from '../data/i18n.js';
import { apps } from '../data/apps.js';
import Logo from '../components/Logo.astro';
import AppIcon from '../components/AppIcon.astro';
import NetworkBg from '../components/NetworkBg.astro';
import GlobeBg from '../components/GlobeBg.astro';

const {
  title,
  description,
  path = '/',
  locale = 'en',
  keywords = '',
  jsonLd = null,
  ogImage: ogImageProp = null,
  ogImageType = 'image/png',
  ogImageW = '1200',
  ogImageH = '630',
  ogImageAlt: ogImageAltProp = null,
} = Astro.props;

const tt = getUI(locale);
const canonical = new URL(localizePath(path, locale), SITE.domain).href;
const altLinks = LOCALES.map((loc) => ({ hreflang: localeHreflang[loc], href: new URL(localizePath(path, loc), SITE.domain).href }));
const ogImage = ogImageProp || new URL('/og.png', SITE.domain).href;
const ogImageAlt = ogImageAltProp || `${SITE.name} — open-source privacy & security tools`;
const pageTitle = title || `${SITE.name} — ${tt.tagline}`;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': SITE.domain + '/#org',
  name: SITE.name,
  alternateName: 'Strix',
  slogan: t.tagline,
  url: SITE.domain + '/',
  logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', SITE.domain).href, width: 512, height: 512 },
  image: ogImage,
  description: t.metaDescription,
  foundingDate: SITE.published,
  sameAs: [SITE.githubUrl],
  knowsAbout: ['privacy software', 'security software', 'open source', 'metadata removal', 'secure data erasure', 'system monitoring', 'hardware diagnostics'],
};
const ldBlocks = [orgLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];

const paletteItems = [
  ...apps.map((a) => { const la = localizeApp(a, locale); return { n: a.name, d: la.tagline, u: localizePath(appPath(a.slug), locale), c: categoryLabel(a.category, locale), k: (a.keywords || '') }; }),
  { n: tt.nav.downloads, d: tt.downloadsLead, u: localizePath(downloadsPath(), locale), c: 'Page', k: 'download install deb exe setup' },
  { n: tt.nav.security, d: tt.securityNote, u: localizePath(securityPath(), locale), c: 'Page', k: 'security verify checksum sha256 provenance attestation antivirus smartscreen signature virustotal' },
  { n: tt.nav.contribute, d: tt.contributeNote, u: localizePath(contributePath(), locale), c: 'Page', k: 'contribute submit your own tool community open source security review hardening add tool' },
  { n: tt.nav.donate, d: tt.donateNote, u: localizePath(donatePath(), locale), c: 'Page', k: 'donate monero xmr support fund crypto cryptocurrency privacy give back' },
  { n: tt.nav.about, d: tt.aboutNote, u: localizePath(aboutPath(), locale), c: 'Page', k: 'about team who makes strix independent open source mission values story' },
  { n: tt.nav.alternatives, d: tt.alternativesNote, u: localizePath(alternativesPath(), locale), c: 'Page', k: 'alternatives open source alternative little snitch glasswire pi-hole dban exiftool cpu-z replace closed source paid' },
  { n: 'GitHub', d: SITE.name, u: SITE.githubUrl, c: 'Page', k: 'github source code repo contribute' },
  { n: 'Home', d: SITE.name, u: localizePath(homePath(), locale), c: 'Page', k: 'home start' },
];
---
<!doctype html>
<html lang={localeHreflang[locale]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content={SITE.author} />
    <meta name="application-name" content={SITE.name} />
    <meta name="apple-mobile-web-app-title" content="Strix" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="generator" content="Astro" />
    <meta name="color-scheme" content="dark light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
    />
    <link rel="canonical" href={canonical} />
    {altLinks.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path, SITE.domain).href} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeOg[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={localeOg[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={ogImageW} />
    <meta property="og:image:height" content={ogImageH} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}
    {SITE.twitter && <meta name="twitter:creator" content={SITE.twitter} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta name="theme-color" content="#090b12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfcfe" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    {ldBlocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b).replace(/</g, '\\u003c')} />)}

    <script is:inline>
      (function () {
        // Clickjacking-Schutz, der auch auf GitHub Pages funktioniert (wo X-Frame-Options
        // und die CSP-Direktive frame-ancestors nicht ausgeliefert werden): Wird diese Seite
        // in einem Frame eingebettet, aus dem Frame ausbrechen; ist das blockiert (Sandbox-Frame), sie ausblenden.
        if (self !== top) {
          try { top.location = self.location; }
          catch (e) { document.documentElement.style.display = 'none'; }
        }
        document.documentElement.classList.add('js');
        try {
          var s = localStorage.getItem('theme');
          var d = s ? s === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = d ? 'dark' : 'light';
        } catch (e) { document.documentElement.dataset.theme = 'dark'; }
      })();
    </script>
    <style is:global>
      :root{
        --bg:#090b12; --bg-1:#0d1120; --bg-2:#111726; --card:#131a2b; --card-2:#161e30;
        --edge:#212a41; --edge-2:#2c374f;
        --text:#e9edf8; --dim:#98a4c2; --faint:#7f8cae;
        --accent:#7c6cff; --accent-2:#33d0ba; --accent-ink:#fff;
        --ring:rgba(124,108,255,.35);
        --max:1140px; --r:16px; --r-lg:22px;
        --sh:0 24px 60px -30px rgba(0,0,0,.75);
        --sh-sm:0 10px 30px -18px rgba(0,0,0,.7);
        --grad:linear-gradient(135deg,var(--accent),var(--accent-2));
      }
      :root[data-theme="light"]{
        --bg:#fbfcfe; --bg-1:#f4f6fb; --bg-2:#eef2f8; --card:#ffffff; --card-2:#f7f9fd;
        --edge:#e4e9f2; --edge-2:#d7deeb;
        --text:#141a2b; --dim:#57637f; --faint:#68738f;
        --accent:#5b47f0; --accent-2:#0ea48a; --ring:rgba(91,71,240,.28);
        --sh:0 24px 60px -34px rgba(30,41,90,.30); --sh-sm:0 10px 30px -18px rgba(30,41,90,.22);
      }
      *{box-sizing:border-box}
      html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
      body{margin:0;background:var(--bg);color:var(--text);
        font:16px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,"Apple Color Emoji",sans-serif;
        -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overflow-x:hidden}
      a{color:inherit;text-decoration:none}
      a:focus-visible,button:focus-visible,summary:focus-visible,input:focus-visible,[tabindex]:focus-visible{
        outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}
      @media print{html.js .reveal{opacity:1!important;transform:none!important}}
      img{max-width:100%;display:block}
      .wrap{max-width:var(--max);margin:0 auto;padding:0 22px}
      h1,h2,h3{letter-spacing:-.02em;line-height:1.12}
      body::before{content:"";position:fixed;inset:0 0 auto 0;height:620px;z-index:-2;pointer-events:none;
        background:
          radial-gradient(680px 400px at 78% -8%, color-mix(in srgb,var(--accent-2) 22%,transparent), transparent 70%),
          radial-gradient(760px 460px at 18% -12%, color-mix(in srgb,var(--accent) 26%,transparent), transparent 70%)}
      .btn{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:12px;
        border:1px solid var(--edge);background:var(--card);color:var(--text);
        font-weight:600;font-size:14px;cursor:pointer;transition:transform .15s,border-color .15s,box-shadow .15s;white-space:nowrap}
      .btn:hover{border-color:color-mix(in srgb,var(--accent) 60%,var(--edge));transform:translateY(-1px)}
      .btn.primary{background:var(--grad);color:#fff;border:none;box-shadow:0 8px 24px -10px var(--ring)}
      .btn.primary:hover{box-shadow:0 14px 30px -10px var(--ring)}
      .btn.ghost{background:transparent}
      .btn.small{padding:7px 12px;font-size:13px;border-radius:10px}
      .btn.block{width:100%;justify-content:center}
      .iconbtn{width:40px;height:40px;justify-content:center;padding:0}
      .chip{display:inline-flex;gap:7px;align-items:center;padding:6px 13px;border-radius:999px;
        border:1px solid var(--edge);background:var(--card);color:var(--dim);font-size:12.5px;font-weight:600}
      .pill{font-size:12px;font-weight:600;padding:4px 10px;border-radius:8px;
        background:var(--bg-2);border:1px solid var(--edge);color:var(--dim)}
      header.site{position:sticky;top:0;z-index:40;backdrop-filter:saturate(140%) blur(12px);
        background:color-mix(in srgb,var(--bg) 78%,transparent);border-bottom:1px solid var(--edge)}
      header.site .bar{display:flex;align-items:center;gap:14px;height:66px}
      .brand{display:flex;align-items:center;gap:11px;font-weight:800;font-size:17px;letter-spacing:-.01em}
      header.site nav{margin-left:auto;display:flex;align-items:center;gap:6px}
      .navlink{padding:9px 12px;border-radius:10px;color:var(--dim);font-weight:600;font-size:14px}
      .navlink:hover{color:var(--text);background:var(--card)}
      details.dd{position:relative}
      details.dd>summary{list-style:none;cursor:pointer;padding:9px 12px;border-radius:10px;
        color:var(--dim);font-weight:600;font-size:14px;display:inline-flex;align-items:center;gap:6px}
      details.dd>summary::-webkit-details-marker{display:none}
      details.dd>summary:hover,details.dd[open]>summary{color:var(--text);background:var(--card)}
      .ddpanel{position:absolute;top:calc(100% + 8px);left:0;width:320px;background:var(--card);
        border:1px solid var(--edge);border-radius:16px;padding:8px;box-shadow:var(--sh);z-index:50}
      .ddpanel a{display:flex;gap:12px;align-items:center;padding:10px;border-radius:11px}
      .ddpanel a:hover{background:var(--bg-2)}
      .ddpanel .n{font-weight:600;font-size:14px}
      .ddpanel .d{color:var(--faint);font-size:12px}
      .dd.lang{margin-left:6px}
      .dd.lang>summary{gap:6px}
      .dd.lang .langcur{font-weight:700;font-size:13px;letter-spacing:.02em}
      .langpanel{width:220px;max-height:min(70vh,460px);overflow-y:auto}
      .langpanel a{gap:11px;align-items:center;padding:9px 11px}
      .langpanel .lc{font:700 11px/1 ui-monospace,monospace;color:var(--faint);border:1px solid var(--edge);
        border-radius:6px;padding:5px 6px;min-width:28px;text-align:center}
      .langpanel a.on{background:var(--bg-2)}
      .langpanel a.on .lc{color:var(--accent);border-color:color-mix(in srgb,var(--accent) 50%,var(--edge))}
      .langpanel .n{font-weight:600;font-size:14px}
      @media(max-width:520px){.dd.lang>summary{padding:9px 8px}}
      footer.site{border-top:1px solid var(--edge);margin-top:70px;background:var(--bg-1)}
      footer.site .cols{display:grid;gap:28px;grid-template-columns:1.6fr 1fr 1fr 1fr;padding:44px 0 26px}
      footer.site h4{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--faint);margin:0 0 12px}
      footer.site a{color:var(--dim);font-size:14px;display:block;padding:4px 0}
      footer.site a:hover{color:var(--text)}
      footer.site .foot-brand p{color:var(--dim);font-size:14px;max-width:34ch;margin:12px 0 0}
      footer.site .legal{border-top:1px solid var(--edge);padding:16px 0;color:var(--faint);font-size:13px;
        display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
      @media(max-width:760px){footer.site .cols{grid-template-columns:1fr 1fr}}
      /* Mobile hamburger menu — holds every nav item once the inline links collapse. */
      .mobmenu{display:none}
      .mobmenu>summary{padding:8px 10px}
      .mobpanel{left:auto;right:0;width:min(86vw,300px);max-height:min(78vh,560px);overflow-y:auto}
      .mobpanel .mobitem{font-weight:600;font-size:15px;color:var(--dim)}
      .mobpanel .mobitem:hover{color:var(--text)}
      .mobsep{height:1px;background:var(--edge);margin:8px 6px}
      .mobhdr{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--faint);padding:6px 10px 4px;font-weight:700}
      .mobpanel .mobapp{gap:11px;align-items:center}
      .mobpanel .mobapp span{font-weight:600;font-size:14px}
      @media(max-width:820px){.navlink.hide-sm,details.dd.hide-sm{display:none}.mobmenu{display:inline-flex}}
      @media(max-width:520px){.brand .wordmark{display:none}}
      .shots{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
      .shot{margin:0;border:1px solid var(--edge);border-radius:14px;overflow:hidden;background:var(--card-2);box-shadow:var(--sh-sm)}
      .shot-bar{display:flex;align-items:center;gap:7px;padding:10px 14px;background:var(--bg-2);border-bottom:1px solid var(--edge)}
      .shot-bar .tl{width:11px;height:11px;border-radius:50%;background:var(--edge-2)}
      .shot-title{margin-left:10px;font-size:12.5px;color:var(--faint)}
      .shot-body{background:#0b0f1c}
      .shot-body img,.shot-body .mockup{width:100%;display:block}
      .shot figcaption{padding:10px 14px;font-size:13px;color:var(--dim);background:var(--card)}
      .searchbtn{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:11px;
        border:1px solid var(--edge);background:var(--card);color:var(--dim);font-weight:600;font-size:13px;cursor:pointer;transition:color .15s,border-color .15s}
      .searchbtn:hover{color:var(--text);border-color:color-mix(in srgb,var(--accent) 55%,var(--edge))}
      .searchbtn kbd{font:600 11px/1 ui-monospace,monospace;border:1px solid var(--edge);border-radius:5px;padding:2px 5px;background:var(--bg-2);color:var(--faint)}
      .cmdk{position:fixed;inset:0;z-index:100;display:grid;place-items:start center;padding-top:12vh}
      .cmdk[hidden]{display:none}
      .cmdk-back{position:fixed;inset:0;background:rgba(4,6,12,.62);backdrop-filter:blur(4px);animation:cmfade .18s ease}
      .cmdk-box{position:relative;width:min(620px,92vw);background:var(--card);border:1px solid var(--edge-2);
        border-radius:18px;box-shadow:0 40px 90px -30px rgba(0,0,0,.8);overflow:hidden;animation:cmpop .2s cubic-bezier(.2,.8,.2,1)}
      @keyframes cmfade{from{opacity:0}}
      @keyframes cmpop{from{opacity:0;transform:translateY(-8px) scale(.98)}}
      .cmdk-top{display:flex;align-items:center;gap:11px;padding:15px 18px;border-bottom:1px solid var(--edge);color:var(--faint)}
      .cmdk-top input{flex:1;background:none;border:none;outline:none;color:var(--text);font-size:16px;font-family:inherit}
      .cmdk-top kbd,.cmdk-foot kbd{font:600 11px/1 ui-monospace,monospace;border:1px solid var(--edge);border-radius:5px;padding:3px 6px;background:var(--bg-2);color:var(--faint)}
      .cmdk-list{list-style:none;margin:0;padding:6px;max-height:44vh;overflow:auto}
      .cmdk-item{display:grid;grid-template-columns:1fr auto;align-items:baseline;gap:6px 12px;padding:11px 12px;border-radius:11px;cursor:pointer}
      .cmdk-item.on{background:var(--bg-2)}
      .cmdk-name{font-weight:600;font-size:14.5px;grid-row:1}
      .cmdk-desc{color:var(--faint);font-size:12.5px;grid-column:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .cmdk-cat{font-size:11px;color:var(--dim);border:1px solid var(--edge);border-radius:7px;padding:3px 8px;grid-row:1;grid-column:2}
      .cmdk-empty{padding:26px;text-align:center;color:var(--faint);font-size:14px}
      .cmdk-foot{display:flex;gap:16px;padding:10px 16px;border-top:1px solid var(--edge);color:var(--faint);font-size:12px}
      .cmdk-foot span{display:inline-flex;align-items:center;gap:5px}
      @media(max-width:520px){.searchbtn{padding:8px}}
    </style>
  </head>
  <body>
    <GlobeBg />
    <NetworkBg />
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href={localizePath(homePath(), locale)} aria-label={SITE.name}>
          <Logo size={34} /> <span class="wordmark">{SITE.name}</span>
        </a>
        <details class="dd lang">
          <summary aria-label={tt.langLabel} title={tt.langLabel}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c2.5 2.4 2.5 15 0 18M12 3c-2.5 2.4-2.5 15 0 18" stroke="currentColor" stroke-width="1.8"/></svg>
            <span class="langcur">{localeShort[locale]}</span> ▾
          </summary>
          <div class="ddpanel langpanel">
            {LOCALES.map((loc) => (
              <a href={localizePath(path, loc)} hreflang={localeHreflang[loc]} aria-current={loc === locale ? 'true' : undefined} class={loc === locale ? 'on' : undefined}>
                <span class="lc">{localeShort[loc]}</span><span class="n">{localeNames[loc]}</span>
              </a>
            ))}
          </div>
        </details>
        <nav>
          <details class="dd hide-sm">
            <summary>{tt.nav.apps} ▾</summary>
            <div class="ddpanel">
              {apps.map((a) => { const la = localizeApp(a, locale); return (
                <a href={localizePath(appPath(a.slug), locale)}>
                  <AppIcon id={a.iconId} accent={a.accent} accent2={a.accent2} size={34} />
                  <span><span class="n">{a.name}</span><br /><span class="d">{la.tagline}</span></span>
                </a>
              ); })}
            </div>
          </details>
          <a class="navlink hide-sm" href={localizePath(downloadsPath(), locale)}>{tt.nav.downloads}</a>
          <a class="navlink hide-sm" href={localizePath(securityPath(), locale)}>{tt.nav.security}</a>
          <a class="navlink hide-sm" href={localizePath(contributePath(), locale)}>{tt.nav.contribute}</a>
          <a class="navlink donate-link hide-sm" href={localizePath(donatePath(), locale)}>{tt.nav.donate}</a>
          <a class="navlink hide-sm" href={SITE.githubUrl} rel="noopener">{tt.nav.github}</a>
          <details class="dd mobmenu">
            <summary aria-label={tt.nav.apps}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </summary>
            <div class="ddpanel mobpanel">
              <a class="mobitem" href={localizePath(downloadsPath(), locale)}>{tt.nav.downloads}</a>
              <a class="mobitem" href={localizePath(alternativesPath(), locale)}>{tt.nav.alternatives}</a>
              <a class="mobitem" href={localizePath(securityPath(), locale)}>{tt.nav.security}</a>
              <a class="mobitem" href={localizePath(contributePath(), locale)}>{tt.nav.contribute}</a>
              <a class="mobitem" href={localizePath(donatePath(), locale)}>{tt.nav.donate}</a>
              <a class="mobitem" href={localizePath(aboutPath(), locale)}>{tt.nav.about}</a>
              <a class="mobitem" href={SITE.githubUrl} rel="noopener">{tt.nav.github}</a>
              <div class="mobsep"></div>
              <span class="mobhdr">{tt.nav.apps}</span>
              {apps.map((a) => (
                <a class="mobapp" href={localizePath(appPath(a.slug), locale)}>
                  <AppIcon id={a.iconId} accent={a.accent} accent2={a.accent2} size={26} />
                  <span>{a.name}</span>
                </a>
              ))}
            </div>
          </details>
          <button class="searchbtn" id="cmdkOpen" aria-label="Search tools" title="Search (Ctrl+K)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <span class="hide-sm">Search</span><kbd class="hide-sm">⌘K</kbd>
          </button>
          <button class="btn iconbtn" id="themeToggle" aria-label="Toggle theme" title="Theme">◐</button>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site">
      <div class="wrap">
        <div class="cols">
          <div class="foot-brand">
            <span class="brand"><Logo size={30} /> {SITE.name}</span>
            <p>{tt.footerTagline} {tt.footerNote}</p>
          </div>
          <div>
            <h4>{tt.footerCols.product}</h4>
            {apps.map((a) => <a href={localizePath(appPath(a.slug), locale)}>{a.name}</a>)}
          </div>
          <div>
            <h4>{tt.footerCols.resources}</h4>
            <a href={localizePath(downloadsPath(), locale)}>{tt.nav.downloads}</a>
            <a href={localizePath(alternativesPath(), locale)}>{tt.nav.alternatives}</a>
            <a href={localizePath(securityPath(), locale)}>{tt.nav.security}</a>
            <a href={localizePath(donatePath(), locale)}>{tt.nav.donate}</a>
            <a href={SITE.githubUrl} rel="noopener">GitHub</a>
          </div>
          <div>
            <h4>{tt.footerCols.about}</h4>
            <a href={localizePath(aboutPath(), locale)}>{tt.nav.about}</a>
            <a href={SITE.githubUrl + '/strix-metavault/blob/main/LICENSE'} rel="noopener">MIT License</a>
            <a href={localizePath(contributePath(), locale)}>{tt.nav.contribute}</a>
          </div>
        </div>
        <div class="legal">
          <span>© 2026 {SITE.name}. MIT licensed.</span>
          <span>github.com/{SITE.org}</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('themeToggle').addEventListener('click', function () {
        var d = document.documentElement.dataset.theme === 'dark';
        var next = d ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
      document.addEventListener('click', function (e) {
        document.querySelectorAll('details.dd[open]').forEach(function (d) {
          if (!d.contains(e.target)) d.removeAttribute('open');
        });
      });
    </script>

    <!-- Befehlspalette (Ctrl/Cmd + K) -->
    <div id="cmdk" class="cmdk" hidden>
      <div class="cmdk-back" data-cmdk-close></div>
      <div class="cmdk-box" role="dialog" aria-modal="true" aria-label="Search tools and pages">
        <div class="cmdk-top">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <input id="cmdkInput" type="text" placeholder="Search tools & pages…" autocomplete="off" spellcheck="false" aria-label="Search" />
          <kbd>Esc</kbd>
        </div>
        <ul id="cmdkList" class="cmdk-list" role="listbox"></ul>
        <div id="cmdkEmpty" class="cmdk-empty" hidden>No matches — try another word.</div>
        <div class="cmdk-foot"><span><kbd>↑</kbd><kbd>↓</kbd> navigate</span><span><kbd>↵</kbd> open</span><span><kbd>esc</kbd> close</span></div>
      </div>
    </div>
    <script is:inline set:html={`window.__STRIX_CMDK__=${JSON.stringify(paletteItems).replace(/</g, '\\u003c')};`}></script>
    <script>
      const cmItems = window.__STRIX_CMDK__ || [];
      const cmModal = document.getElementById('cmdk');
      const cmInput = document.getElementById('cmdkInput');
      const cmList = document.getElementById('cmdkList');
      const cmEmpty = document.getElementById('cmdkEmpty');
      let cmActive = 0;
      const cmEsc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      function cmRender(q) {
        q = q.trim().toLowerCase();
        const f = cmItems.filter((it) => !q || (it.n + ' ' + it.d + ' ' + it.c + ' ' + (it.k || '')).toLowerCase().indexOf(q) !== -1);
        cmActive = 0;
        cmList.innerHTML = f.map((it, i) =>
          `<li role="option" class="cmdk-item${i === 0 ? ' on' : ''}" data-url="${cmEsc(it.u)}">` +
          `<span class="cmdk-name">${cmEsc(it.n)}</span><span class="cmdk-desc">${cmEsc(it.d)}</span>` +
          `<span class="cmdk-cat">${cmEsc(it.c)}</span></li>`).join('');
        cmEmpty.hidden = f.length !== 0;
      }
      function cmOpen() { cmModal.hidden = false; document.body.style.overflow = 'hidden'; cmInput.value = ''; cmRender(''); setTimeout(() => cmInput.focus(), 20); }
      function cmClose() { cmModal.hidden = true; document.body.style.overflow = ''; }
      function cmMove(d) { const els = Array.from(cmList.children); if (!els.length) return; els[cmActive] && els[cmActive].classList.remove('on'); cmActive = (cmActive + d + els.length) % els.length; const el = els[cmActive]; el.classList.add('on'); el.scrollIntoView({ block: 'nearest' }); }
      if (cmInput) cmInput.addEventListener('input', () => cmRender(cmInput.value));
      if (cmList) cmList.addEventListener('click', (e) => { const li = e.target.closest('.cmdk-item'); if (li) location.href = li.dataset.url; });
      document.querySelectorAll('[data-cmdk-close]').forEach((el) => el.addEventListener('click', cmClose));
      const cmTrigger = document.getElementById('cmdkOpen'); if (cmTrigger) cmTrigger.addEventListener('click', cmOpen);
      document.addEventListener('keydown', (e) => {
        if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) { e.preventDefault(); cmModal.hidden ? cmOpen() : cmClose(); return; }
        if (cmModal.hidden) return;
        if (e.key === 'Escape') cmClose();
        else if (e.key === 'ArrowDown') { e.preventDefault(); cmMove(1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); cmMove(-1); }
        else if (e.key === 'Enter') { e.preventDefault(); const el = cmList.children[cmActive]; if (el) location.href = el.dataset.url; }
      });
    </script>
  </body>
</html>
